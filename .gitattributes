# 统一换行：文本文件仓库内以 LF 存储，检出也用 LF。
* text=auto eol=lf

# Windows 批处理必须是 CRLF。
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行/编码转换。
*.dll binary
*.lib binary
*.exe binary
*.bmp binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary

# 明确为文本的关键文件（防止被误判为二进制）。
*.rs   text
*.toml text
*.md   text
*.lock text
